# NapCat OneBot 11: enable HTTP server and WebSocket server in NapCat, then
# point this process at them. Use the same access token on both sides.
NAPCAT_HTTP_URL=http://127.0.0.1:3000
NAPCAT_WS_URL=ws://127.0.0.1:3001
NAPCAT_ACCESS_TOKEN=
NAPCAT_REQUEST_TIMEOUT=15
NAPCAT_RECONNECT_MIN_DELAY=1
NAPCAT_RECONNECT_MAX_DELAY=30
NAPCAT_MAX_CONCURRENCY=8
# 已废弃：所有群聊无条件静默；即使设为1也不回复。群转发规则由管理员私聊配置。
NAPCAT_RESPOND_WITHOUT_MENTION=0
MAIDANLAO_DB=maidanlao.sqlite3
DATABASE_URL=sqlite:///maidanlao.sqlite3
# MAIDANLAO_DB_DRIVER is a legacy field and is not read by this runtime.
# Database priority: explicit path > DATABASE_URL > MAIDANLAO_DB > default.
MAIDANLAO_ADMIN_TOKEN=
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_TEMPERATURE=0.3
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=qwen3.7-text-embedding-flash
# Empty key reuses EMBEDDING_API_KEY. Empty model disables cloud reranking.
RERANK_MODEL=qwen3.7-text-rerank
RERANK_API_KEY=
RERANK_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
RERANK_TIMEOUT=15
LOG_LEVEL=INFO

# 统一 Agent 的通知工具根据 NapCat 入站真实 QQ 号授权；CLI 用户号不授予权限。
NOTIFICATION_ADMIN_QQ=3244104494
# Serial notification send interval, in seconds (default: 1).
NOTIFICATION_SEND_INTERVAL=1

# Deployment uses deploy/ systemd templates; see docs/TECHNICAL_DOCUMENTATION.md.
